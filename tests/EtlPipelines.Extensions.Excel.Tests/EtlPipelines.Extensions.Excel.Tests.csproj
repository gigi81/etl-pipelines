<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!--
      Left at the project's pre-rename name: the library it tests names its own types
      EtlPipelines.Excel.*, not EtlPipelines.Extensions.Excel.* - only the package identity moved. The
      default RootNamespace (derived from this project's own name) would collide with the static
      class named EtlPipelines.Extensions that every connector's Extensions.cs declares.
    -->
    <RootNamespace>EtlPipelines.Excel.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.TestingHelpers" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.Extensions" />
    <!--
      The library itself needs only the interfaces — it never constructs a filesystem. The tests do,
      because a few of them deliberately run against the real one to catch places where the in-memory
      implementation and a real disk disagree.
    -->
    <PackageReference Include="TestableIO.System.IO.Abstractions.Wrappers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EtlPipelines.Extensions.Excel\EtlPipelines.Extensions.Excel.csproj" />
    <ProjectReference Include="..\..\src\EtlPipelines.Core\EtlPipelines.Core.csproj" />
  </ItemGroup>

</Project>
