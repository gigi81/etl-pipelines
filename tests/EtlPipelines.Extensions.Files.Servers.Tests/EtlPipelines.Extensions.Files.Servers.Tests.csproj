<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!--
      This project's own namespace, EtlPipelines.Extensions.Files.Servers.Tests, is a warning-level
      ambiguity (CS0435) against the static class literally named EtlPipelines.Extensions that each of
      Files and Files.Sftp's own Extensions.cs declares. The compiler already resolves it correctly -
      the namespace declared in source wins over the imported type - so this only silences the
      diagnostic; TreatWarningsAsErrors is what would otherwise turn a correct resolution into a build
      failure.
    -->
    <NoWarn>$(NoWarn);CS0435</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.TestingHelpers" />
    <!--
      No Testcontainers.Sftp module exists, so the fixture uses the generic ContainerBuilder that
      already comes with Testcontainers itself.
    -->
    <PackageReference Include="Testcontainers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EtlPipelines.Core\EtlPipelines.Core.csproj" />
    <ProjectReference Include="..\..\src\EtlPipelines.Extensions.Files\EtlPipelines.Extensions.Files.csproj" />
    <ProjectReference Include="..\..\src\EtlPipelines.Extensions.Files.Sftp\EtlPipelines.Extensions.Files.Sftp.csproj" />
  </ItemGroup>

</Project>
