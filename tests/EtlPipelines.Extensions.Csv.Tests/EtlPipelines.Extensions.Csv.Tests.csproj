<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!--
      This project's own namespace, EtlPipelines.Extensions.Csv.Tests, is a warning-level ambiguity
      (CS0435) against the static class literally named EtlPipelines.Extensions that
      EtlPipelines.Extensions.Csv's own Extensions.cs declares. The compiler already resolves it
      correctly - the namespace declared in source wins over the imported type - so this only silences
      the diagnostic; TreatWarningsAsErrors is what would otherwise turn a correct resolution into a
      build failure.
    -->
    <NoWarn>$(NoWarn);CS0435</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.TestingHelpers" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.Extensions" />
    <!--
      The library itself needs only the interfaces — it never constructs a filesystem. The tests do,
      because a few of them deliberately run against the real one to catch places where the in-memory
      implementation and a real disk disagree.
    -->
    <PackageReference Include="TestableIO.System.IO.Abstractions.Wrappers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EtlPipelines.Extensions.Csv\EtlPipelines.Extensions.Csv.csproj" />
    <ProjectReference Include="..\..\src\EtlPipelines.Core\EtlPipelines.Core.csproj" />
  </ItemGroup>

</Project>
