<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!--
      This project's own namespace, EtlPipelines.Extensions.Files.Tests, is a warning-level ambiguity
      (CS0435) against the static class literally named EtlPipelines.Extensions that each of Files,
      Files.Http and Files.Sftp's own Extensions.cs declares. The compiler already resolves it
      correctly - the namespace declared in source wins over the imported type - so this only silences
      the diagnostic; TreatWarningsAsErrors is what would otherwise turn a correct resolution into a
      build failure.
    -->
    <NoWarn>$(NoWarn);CS0435</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TestableIO.System.IO.Abstractions.TestingHelpers" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <!-- Mocking ISftpClient - SSH.NET's own client interface, not a wrapper of our own. -->
    <PackageReference Include="Moq" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EtlPipelines.Extensions.Files\EtlPipelines.Extensions.Files.csproj" />
    <ProjectReference Include="..\..\src\EtlPipelines.Extensions.Files.Http\EtlPipelines.Extensions.Files.Http.csproj" />
    <ProjectReference Include="..\..\src\EtlPipelines.Extensions.Files.Sftp\EtlPipelines.Extensions.Files.Sftp.csproj" />
    <ProjectReference Include="..\..\src\EtlPipelines.Core\EtlPipelines.Core.csproj" />
  </ItemGroup>

</Project>
