<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Hosts all three v1 services - first project in the repo to use the Web SDK. Phase 2 scaffolds
    every RPC as a "not implemented yet" stub (see Services/) so the whole surface exists and the
    host builds and starts clean; each later phase (3, 4, 5/6) fills in real behaviour for the
    RPCs it needs.
  -->
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" />
    <!--
      Phase 4: NuGet.Protocol/NuGet.Versioning browse the one bagetter feed for
      ListAvailablePackages/ListUpdates - metadata only, never a download. Microsoft.AspNetCore.
      DataProtection (SecretsStore's secrets-at-rest mechanism) needs no PackageReference at all -
      it ships in the ASP.NET Core shared framework this Web SDK project already references, and
      NU1510 (a warning-as-error here) refuses an explicit one as redundant.
    -->
    <PackageReference Include="NuGet.Protocol" />
    <PackageReference Include="NuGet.Packaging" />
    <PackageReference Include="NuGet.Versioning" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EtlPipelines.Server.Database\EtlPipelines.Server.Database.csproj" />
    <!-- The REST API's request/response records (Api/ApiEndpoints.cs maps them). -->
    <ProjectReference Include="..\EtlPipelines.Server.Contracts\EtlPipelines.Server.Contracts.csproj" />
    <!-- Generated proto types (messages, service base classes) - see that project's own comment. -->
    <ProjectReference Include="..\EtlPipelines.Protos\EtlPipelines.Protos.csproj" />
  </ItemGroup>

</Project>
