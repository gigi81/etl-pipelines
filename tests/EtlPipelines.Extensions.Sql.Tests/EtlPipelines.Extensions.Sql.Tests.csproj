<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!--
      Left at the project's pre-rename name: the libraries it tests name their own types
      EtlPipelines.Sql*, not EtlPipelines.Extensions.Sql* - only the package identity moved. The
      default RootNamespace (derived from this project's own name) would collide with the static
      class named EtlPipelines.Extensions that every connector's Extensions.cs declares - and it would
      also rename the embedded scripts' logical resource names below, which the tests find by name.
    -->
    <RootNamespace>EtlPipelines.Sql.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiled into the assembly, so the embedded-script tests have a real resource to find. -->
    <EmbeddedResource Include="Scripts\**\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.TestingHelpers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EtlPipelines.Extensions.Sql\EtlPipelines.Extensions.Sql.csproj" />
    <ProjectReference Include="..\..\src\EtlPipelines.Extensions.Sql.Sqlite\EtlPipelines.Extensions.Sql.Sqlite.csproj" />
    <!--
      The provider packages, for their script parsers alone. Splitting a file into batches is pure
      text work needing no server, and it is the part most likely to be got wrong - so it is tested
      here, where it runs on every CI leg, rather than behind a container.
    -->
    <ProjectReference Include="..\..\src\EtlPipelines.Extensions.Sql.SqlServer\EtlPipelines.Extensions.Sql.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\EtlPipelines.Extensions.Sql.MySql\EtlPipelines.Extensions.Sql.MySql.csproj" />
    <ProjectReference Include="..\..\src\EtlPipelines.Extensions.Sql.PostgreSql\EtlPipelines.Extensions.Sql.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\EtlPipelines.Extensions.Sql.Oracle\EtlPipelines.Extensions.Sql.Oracle.csproj" />
    <ProjectReference Include="..\..\src\EtlPipelines.Core\EtlPipelines.Core.csproj" />
  </ItemGroup>

</Project>
