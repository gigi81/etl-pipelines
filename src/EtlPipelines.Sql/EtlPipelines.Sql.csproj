<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Provider-agnostic ADO.NET source and sink for EtlPipelines.</Description>
  </PropertyGroup>

  <!--
    Deliberately references the abstractions only, not the EtlPipelines.Core runtime. Every type a
    connector needs - the ports, the lifecycle interfaces, and the builder interfaces - lives in
    Abstractions, so a connector never depends on the execution engine.

    No driver package either: everything here works against System.Data.Common, and each
    EtlPipelines.Sql.<Provider> package brings its own driver and bulk-load fast path.
  -->
  <ItemGroup>
    <ProjectReference Include="..\EtlPipelines.Abstractions\EtlPipelines.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Dapper, for one thing only: turning an open reader into a compiled row mapper, so a caller who
      does not want to hand-write one does not have to. No Dapper type appears in this package's
      public surface, and nothing here goes through its query APIs - they buffer whole result sets,
      which is the opposite of what a streaming pipeline wants.
    -->
    <PackageReference Include="Dapper" />
    <!-- Resolving connection factories and bulk loaders out of the container. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- Reading connection strings from IConfiguration.GetConnectionString. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
  </ItemGroup>

</Project>
