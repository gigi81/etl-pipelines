<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Generated C# types for every protos/v1/*.proto file - messages, service base classes, and typed clients, all compiled exactly once here.</Description>
  </PropertyGroup>

  <!--
    Phase 5: extracted out of EtlPipelines.Server/EtlPipelines.GrpcClient/EtlPipelines.Agent.
    GrpcClient, which each used to compile their own proto(s) directly (GrpcServices="Server" or
    "Client"). That worked only as long as nothing ever referenced two of those projects at once -
    protoc regenerates a full, distinct set of message/service types per project that compiles a
    given .proto file, so two projects compiling the same .proto and then both being referenced by
    a third (EtlPipelines.Server.Tests's end-to-end InstallLoopDockerTests, which needs a real
    Server - EtlPipelines.Server - and a real Agent - EtlPipelines.Agent, pulling in
    EtlPipelines.Agent.GrpcClient - in the same process) collide: CS0433 "the type 'X' exists in
    both A and B". GrpcServices="Both" here, compiled once, is what removes the possibility of that
    collision for good, for every proto in this repo, rather than special-casing agent_execution.
    proto/management.proto for this one test. Every project that used to compile a .proto directly
    now references this project instead and keeps only the runtime package(s) its own role needs
    (Grpc.AspNetCore to host, Grpc.Net.Client/Grpc.Net.ClientFactory to call out).
  -->
  <ItemGroup>
    <Protobuf Include="..\..\protos\v1\pipeline_execution.proto" GrpcServices="Both" ProtoRoot="..\..\protos" />
    <Protobuf Include="..\..\protos\v1\agent_execution.proto" GrpcServices="Both" ProtoRoot="..\..\protos" />
    <Protobuf Include="..\..\protos\v1\management.proto" GrpcServices="Both" ProtoRoot="..\..\protos" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.Tools" />
  </ItemGroup>

</Project>
