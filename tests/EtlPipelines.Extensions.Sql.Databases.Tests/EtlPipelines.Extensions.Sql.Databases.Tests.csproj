<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!--
      Left at the project's pre-rename name: the libraries it tests name their own types
      EtlPipelines.Sql*, not EtlPipelines.Extensions.Sql* - only the package identity moved. The
      default RootNamespace (derived from this project's own name) would collide with the static
      class named EtlPipelines.Extensions that every connector's Extensions.cs declares.
    -->
    <RootNamespace>EtlPipelines.Sql.Databases.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.TestingHelpers" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.MySql" />
    <PackageReference Include="Testcontainers.MariaDb" />
    <PackageReference Include="Testcontainers.Oracle" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EtlPipelines.Core\EtlPipelines.Core.csproj" />
    <ProjectReference Include="..\..\src\EtlPipelines.Extensions.Sql\EtlPipelines.Extensions.Sql.csproj" />
    <ProjectReference Include="..\..\src\EtlPipelines.Extensions.Sql.SqlServer\EtlPipelines.Extensions.Sql.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\EtlPipelines.Extensions.Sql.PostgreSql\EtlPipelines.Extensions.Sql.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\EtlPipelines.Extensions.Sql.MySql\EtlPipelines.Extensions.Sql.MySql.csproj" />
    <ProjectReference Include="..\..\src\EtlPipelines.Extensions.Sql.Oracle\EtlPipelines.Extensions.Sql.Oracle.csproj" />
  </ItemGroup>

</Project>
