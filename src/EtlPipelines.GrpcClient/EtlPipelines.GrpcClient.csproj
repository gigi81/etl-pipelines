<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Typed gRPC client for an arbitrary pipeline process to reach PipelineExecutionService - configuration, progress reporting, heartbeats.</Description>
  </PropertyGroup>

  <!--
    Phase 2 scaffolding only: the generated client type from EtlPipelines.Protos is everything
    this project has for now - no code here calls it yet. Phase 6 adds
    GrpcConfigurationProvider/GrpcConfigurationSource and GrpcProgressReporter, the real
    consumers, plus EtlPipelinesHost.UseGrpcClient(...) for the session-id/server-url options.
  -->
  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated proto types (messages, typed client) - see that project's own comment. -->
    <ProjectReference Include="..\EtlPipelines.Protos\EtlPipelines.Protos.csproj" />
  </ItemGroup>

</Project>
