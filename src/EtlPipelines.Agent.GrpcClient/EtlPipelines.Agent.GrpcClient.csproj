<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 5: AddAgentGrpcClient(...) is the one thing this project adds beyond the generated
    client itself - a typed-client DI registration EtlPipelines.Agent's own Program.cs/
    AgentApplication.cs calls, the same shape EtlPipelines.GrpcClient will eventually offer
    pipeline processes (Phase 6).
  -->
  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated proto types (messages, typed client) - see that project's own comment. -->
    <ProjectReference Include="..\EtlPipelines.Protos\EtlPipelines.Protos.csproj" />
  </ItemGroup>

</Project>
