<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Runs EtlPipelines pipelines as a command line application.</Description>
    <!--
      The Albatross.CommandLine source generator emits public command classes with no XML comments,
      and this repository builds with GenerateDocumentationFile and TreatWarningsAsErrors, so CS1591
      would fail the build on code nobody here writes. CS1591 is only controllable through NoWarn -
      an .editorconfig severity for *.g.cs does not reach it - so it is off for this project, and the
      hand-written types below carry their documentation by review rather than by the compiler.
    -->
    <!--
      NU5104: Albatross.CommandLine is a release candidate, and packing a stable version with a
      prerelease dependency is an error rather than a warning here. Without this a tagged release
      could not be packed at all. Drop it when the dependency goes stable.
    -->
    <NoWarn>$(NoWarn);CS1591;NU5104</NoWarn>
  </PropertyGroup>

  <!--
    Abstractions only, like the connectors: everything needed to run a pipeline and report on it -
    IPipeline, PipelineResult - is declared there, so hosting does not depend on the execution engine.
  -->
  <ItemGroup>
    <ProjectReference Include="..\EtlPipelines.Abstractions\EtlPipelines.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brings System.CommandLine and Microsoft.Extensions.Hosting with it. -->
    <PackageReference Include="Albatross.CommandLine" />
    <!--
      The file connectors name their files as IFileInfo rather than as paths, so an application built
      on this host needs an IFileSystem in the container. Wrappers rather than the abstractions alone,
      because the host is the thing that supplies the real implementation.
    -->
    <PackageReference Include="TestableIO.System.IO.Abstractions.Wrappers" />
  </ItemGroup>

</Project>
