<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Runs EtlPipelines pipelines as a command line application.</Description>
    <!--
      The Albatross.CommandLine source generator emits public command classes with no XML comments,
      and this repository builds with GenerateDocumentationFile and TreatWarningsAsErrors, so CS1591
      would fail the build on code nobody here writes. CS1591 is only controllable through NoWarn -
      an .editorconfig severity for *.g.cs does not reach it - so it is off for this project, and the
      hand-written types below carry their documentation by review rather than by the compiler.
    -->
    <!--
      NU5104: Albatross.CommandLine is a release candidate, and packing a stable version with a
      prerelease dependency is an error rather than a warning here. Without this a tagged release
      could not be packed at all. Drop it when the dependency goes stable.
    -->
    <NoWarn>$(NoWarn);CS1591;NU5104</NoWarn>
  </PropertyGroup>

  <!--
    Core as well as Abstractions, unlike the connectors. A connector must not drag in the execution
    engine; this package is the engine's front door, and any application using it has already called
    AddEtlPipeline. Referencing it means the activity source name comes from EtlDiagnostics, where it
    is declared, rather than being repeated here as a string that must silently match.
  -->
  <ItemGroup>
    <ProjectReference Include="..\EtlPipelines.Abstractions\EtlPipelines.Abstractions.csproj" />
    <ProjectReference Include="..\EtlPipelines.Core\EtlPipelines.Core.csproj" />
    <!--
      SERVER.md Phase 6: every application built on EtlPipelinesHost gets the session-id/server-url
      options and the gRPC-backed configuration pull/progress reporting they turn on built in, not as a
      separate opt-in package a sample has to reference and call itself - see
      EtlPipelinesHost's own constructor/RunAsync. EtlPipelines.GrpcClient stays the home of the
      actual gRPC pieces (GrpcConfigurationSource/Provider, GrpcProgressReporter) precisely so it
      can be referenced on its own, by something that is not an EtlPipelinesHost application at
      all - the dependency runs this direction, never the reverse.
    -->
    <ProjectReference Include="..\EtlPipelines.GrpcClient\EtlPipelines.GrpcClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brings System.CommandLine and Microsoft.Extensions.Hosting with it. -->
    <PackageReference Include="Albatross.CommandLine" />
    <!--
      The file connectors name their files as IFileInfo rather than as paths, so an application built
      on this host needs an IFileSystem in the container. Wrappers rather than the abstractions alone,
      because the host is the thing that supplies the real implementation.
    -->
    <PackageReference Include="TestableIO.System.IO.Abstractions.Wrappers" />
    <!-- The typed PipelineExecutionServiceClient this host wires in by default - see the ProjectReference to EtlPipelines.GrpcClient above. -->
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
  </ItemGroup>

</Project>
